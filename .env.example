# Copy this file to .env.local for local testing (never commit .env.local).
# On Hostinger add the same names in hPanel → Websites → your site → Environment variables.

# Hostinger email SMTP (hPanel → Emails → your mailbox → Configuration settings)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@adboex.com
SMTP_PASS=your-mailbox-password

# Where form submissions are delivered
CONTACT_TO=info@adboex.com

# Optional: "from" address (defaults to SMTP_USER; must be a mailbox you own)
CONTACT_FROM=
