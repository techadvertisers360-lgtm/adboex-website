{
  "name": "adboex-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "seo:check": "npm run clean && next build && node scripts/seo-check.mjs",
    "seo:report": "node scripts/seo-check.mjs",
    "check": "npm run lint && npm run seo:check",
    "placeholders": "node scripts/make-placeholders.mjs",
    "icons": "node scripts/make-icons.mjs",
    "globe-image": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-globe-image.mjs",
    "demo-images": "node scripts/fetch-demo-images.mjs",
    "orb-image": "node scripts/make-orb.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "github-slugger": "^2.0.0",
    "lucide-react": "^0.540.0",
    "next": "^15.5.0",
    "next-mdx-remote": "^5.0.0",
    "nodemailer": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "three": "^0.187.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "tslib": "2.8.1"
  }
}
